PORT=3025
HOST=0.0.0.0
STRATA_STATE_DIR=.state
STRATA_PUBLIC_DIR=dist/client
CHAIN_ENABLED=false
# Enable only after provisioning dedicated test keys, mint and program.
SOLANA_NETWORK=localnet
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_GENESIS_HASH=
REPLAY_EXPIRY_SECONDS=90
# COOKIE_SECURE=true when serving through HTTPS.

# Optional current Parcel program. Fail closed when enabled; private localnet only.
ODDLOT_CHAIN_ENABLED=false
ODDLOT_PROGRAM_ID=
ODDLOT_CASH_MINT=
ODDLOT_STOCK_MINT=

# Pre-IPO covered calls. Verification is read-only and needs no keys.
PREIPO_VERIFY_RPC_URL=https://api.mainnet-beta.solana.com
PREIPO_VERIFY_NETWORK=mainnet
# Leave unset until a covered-call program is built and deployed. These gate
# on-chain execution only: the ticket writes through the vault without them.
PREIPO_PROGRAM_ID=
PREIPO_USDC_MINT=

# Live marks. Both sources are read-only, and the desk runs without either:
# anything with no fresh observation is walked from its last real mark and
# labelled as simulated.
# Pyth is the only one of the two that publishes equities. Its price endpoint
# now requires a key, so without PYTH_API_KEY it resolves its feed ids, takes
# one 401 and stands down.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=
# Coinbase needs no key and covers the crypto collateral.
COINBASE_API_URL=https://api.exchange.coinbase.com
