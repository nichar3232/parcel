PORT=3025
HOST=0.0.0.0
STRATA_STATE_DIR=.state
STRATA_PUBLIC_DIR=dist/client
CHAIN_ENABLED=false
# Enable only after provisioning dedicated test keys, mint and program.
# localnet is the pinned private validator; devnet is the public test cluster.
# Mainnet is refused by the genesis pin and cannot be configured.
SOLANA_NETWORK=localnet
SOLANA_RPC_URL=http://127.0.0.1:8899
# Required whenever chain execution is on. Localnet: the validator's own
# genesis. Devnet: EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG.
SOLANA_GENESIS_HASH=
REPLAY_EXPIRY_SECONDS=90
# COOKIE_SECURE=true when serving through HTTPS.

# Optional current Parcel program. Fail closed when enabled. Accepts the pinned
# private localnet or devnet; a devnet RPC must be HTTPS.
#   SOLANA_NETWORK=devnet
#   SOLANA_RPC_URL=https://api.devnet.solana.com
#   SOLANA_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
PARCEL_CHAIN_ENABLED=false
PARCEL_PROGRAM_ID=
PARCEL_CASH_MINT=
PARCEL_STOCK_MINT=

# Pre-IPO covered calls. Verification is read-only and needs no keys.
PREIPO_VERIFY_RPC_URL=https://api.mainnet-beta.solana.com
PREIPO_VERIFY_NETWORK=mainnet
# Leave unset until a covered-call program is built and deployed. These gate
# on-chain execution only: the ticket writes through the vault without them.
PREIPO_PROGRAM_ID=
PREIPO_USDC_MINT=

# Live marks. Market-data credentials stay on the server. A source that is
# absent, stale, or unavailable is never displayed as a live price; the
# sandbox fallback remains explicitly labelled simulated.
#
# Listed U.S. equities: Massive streams NBBO updates over one server-side
# WebSocket. Use a real-time entitled key for execution-grade monitoring. Set
# MASSIVE_STOCKS_FEED=delayed only when you intentionally want a delayed desk;
# the API exposes that provenance to the UI.
MASSIVE_STOCKS_API_KEY=
MASSIVE_STOCKS_FEED=realtime
MASSIVE_STOCKS_WS_URL=wss://socket.massive.com/stocks
# Keep false in a local sandbox. A monitored deployment should set true so
# `/api/ready` fails closed unless the real-time NBBO stream is authenticated.
MARKET_DATA_REQUIRED=false
# Pyth provides oracle marks, not a bid/ask. Its authenticated Hermes endpoint
# is a fallback/oracle source and cannot be presented as executable liquidity.
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=
# Coinbase provides its own venue BBO for crypto collateral, not a consolidated
# cross-venue NBBO.
COINBASE_API_URL=https://api.exchange.coinbase.com

# Tokenized-equity watchlist issuer sources. xStocks and Opening Bell have
# public APIs. Ondo's issuer API is credentialed; leave its key empty to keep
# that source visibly unavailable rather than showing a substitute quote.
XSTOCKS_API_URL=https://api.xstocks.fi/api/v2
SUPERSTATE_API_URL=https://api.superstate.com
ONDO_API_URL=https://api.gm.ondo.finance
ONDO_API_KEY=
