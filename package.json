{
  "name": "parcel",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "PARCEL_DEMO=1 vinext dev",
    "build": "vinext build",
    "start": "tsx server/index.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "serve": "tsx server/index.ts",
    "verify:chain": "node scripts/verify-contract.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "verify:backend-chain": "tsx scripts/audit-chain.ts",
    "verify:restart": "node scripts/check-restart.mjs",
    "record:demo": "node scripts/record-oddlot.mjs",
    "demo": "PARCEL_DEMO=1 CHAIN_ENABLED=false tsx server/index.ts",
    "check:repo": "node scripts/check-repository.mjs",
    "record:legacy": "node scripts/record-demo.mjs",
    "verify:oddlot-chain": "tsx scripts/verify-oddlot-chain.ts",
    "verify:oddlot-adversarial": "tsx scripts/verify-oddlot-adversarial.ts",
    "verify:oddlot-suite": "tsx scripts/verify-oddlot-suite.ts",
    "generate:oddlot-market": "tsx scripts/generate-oddlot-market.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "bigint-buffer": "file:vendor/bigint-buffer",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "type": "module",
  "overrides": {
    "uuid": "11.1.1",
    "ws": "8.21.3",
    "bigint-buffer": "$bigint-buffer"
  },
  "description": "Options by the share: collateral vaults, covered underwriting, structured positions and protected stock lending.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nichar3232/parcel.git"
  }
}
